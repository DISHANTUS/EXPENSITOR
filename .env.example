# ----------------------------------------------------------------------------
# Expensitor environment configuration (TEMPLATE)
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# ----------------------------------------------------------------------------

# --- Application ---
ENVIRONMENT=development
DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# --- Security ---
# Generate a strong key, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256

# --- PostgreSQL ---
# POSTGRES_SERVER must be `db` when running via docker compose (the service name).
# Use `localhost` only when running the API outside Docker against a local DB.
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=expensitor
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=expensitor

# --- Connection pool ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- CORS (JSON array or comma-separated) ---
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# --- Domain defaults ---
DEFAULT_BASE_CURRENCY=INR

# --- Exchange-rate provider (free, no API key) ---
FRANKFURTER_BASE_URL=https://api.frankfurter.app
